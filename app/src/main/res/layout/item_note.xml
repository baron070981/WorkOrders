<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemnote"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginHorizontal="5dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/item_element_draw"
    app:layout_constrainedHeight="true">

    <View
        android:id="@+id/vmarker"
        android:layout_width="10dp"
        android:layout_height="160dp"
        android:background="@color/marker_completed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_create_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="01.01.2026"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintStart_toEndOf="@+id/vmarker"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/tv_item_complete_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="01.01.2026"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_date_complete" />

    <TextView
        android:id="@+id/tv_item_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:lines="2"
        android:text="address"
        android:textColor="@color/primary_textcolor"
        android:textIsSelectable="false"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vmarker"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_create_date" />

    <TextView
        android:id="@+id/tv_item_task_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="task content"
        android:textColor="@color/primary_textcolor"
        android:textIsSelectable="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vmarker"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_address" />

    <TextView
        android:id="@+id/tv_item_to_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="01.01.2026"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintStart_toEndOf="@+id/tv_item_create_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_label_to_date" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="создана"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintStart_toEndOf="@+id/vmarker"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_label_to_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="на какое"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintStart_toEndOf="@+id/tv_item_create_date"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_label_date_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="сделана"
        android:textColor="@color/primary_textcolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_item_marker_phone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/phoneiconb" />

</androidx.constraintlayout.widget.ConstraintLayout>