<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B9DED6"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/ll_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_draw"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_widget_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="5dp"
            android:text="В РАБОТЕ"
            android:textColor="@color/primary_textcolor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="5dp"
            android:text="0"
            android:textColor="@color/marker_not_complete"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>