<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WorkOrders" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.WorkOrders" parent="Base.Theme.WorkOrders" />

    <style name="ThemeEditTextInputTask" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/primary_textcolor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColorHint">#C846569D</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textCursorDrawable">@drawable/cursor_draw</item>
    </style>

    <style name="ThemeEditTextSearchTask" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingVertical">5px</item>
        <item name="android:paddingHorizontal">5px</item>
        <item name="android:textColorHint">#BAE2E2E4</item>
        <item name="android:gravity">center</item>
        <item name="android:textCursorDrawable">@drawable/cursor_draw_white</item>
    </style>

    <style name="ThemeTextViewLabelsInputTask" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/primary_textcolor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="ThemeTextViewLabels" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary_textcolor</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="ThemeTextViewInfo" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/primary_textcolor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="ThemeButtonStyle1" parent="Widget.AppCompat.ActionButton">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>


</resources>